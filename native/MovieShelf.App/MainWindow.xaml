<Window
    x:Class="MovieShelf.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MovieShelf.App">

    <Grid x:Name="Root">
        <Grid.Resources>
            <DataTemplate x:Key="CardTemplate" x:DataType="local:MovieItem">
                <StackPanel Width="{x:Bind CardW}" Margin="6,6,6,10" Spacing="3">
                    <Grid Width="{x:Bind CardW}" Height="{x:Bind CardH}" CornerRadius="8"
                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Image Source="{x:Bind Poster}" Stretch="UniformToFill" />
                        <TextBlock Text="{x:Bind Placeholder}" Visibility="{x:Bind NoPosterVis}" Margin="12"
                                   TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FlowDirection="LeftToRight" />
                        <Border Visibility="{x:Bind RatingVis}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                Padding="6,2" CornerRadius="4" Background="#CC000000">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <FontIcon Glyph="&#xE735;" FontSize="11" Foreground="#FFFBBF24" />
                                <TextBlock Text="{x:Bind RatingText}" FontSize="12" Foreground="White" />
                            </StackPanel>
                        </Border>
                        <Border Visibility="{x:Bind ResVis}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                Padding="6,2" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="{x:Bind ResText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <Border Visibility="{x:Bind ScoreVis}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,32,6,6"
                                Padding="6,2" CornerRadius="4" Background="#CC000000">
                            <TextBlock Text="{x:Bind ScoreText}" FontSize="11" Foreground="White" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Spacing="4">
                            <Border Visibility="{x:Bind FaVis}" Padding="5,3" CornerRadius="4" Background="#CC7C3AED">
                                <TextBlock Text="FA" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <Border Visibility="{x:Bind FavVis, Mode=OneWay}" Padding="4" CornerRadius="4" Background="#CC000000">
                                <FontIcon Glyph="&#xEB51;" FontSize="12" Foreground="#FFFF6B81" />
                            </Border>
                            <Border Visibility="{x:Bind WatchedVis, Mode=OneWay}" Padding="4" CornerRadius="4" Background="#CC000000">
                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#FF4ADE80" />
                            </Border>
                            <Border Visibility="{x:Bind FlagVis}" Padding="4" CornerRadius="4" Background="#CC000000">
                                <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="#FFFBBF24" />
                            </Border>
                        </StackPanel>
                        <Border Visibility="{x:Bind FilesVis}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                Padding="6,2" CornerRadius="4" Background="#CC000000">
                            <TextBlock Text="{x:Bind FilesText}" FontSize="11" Foreground="White" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" FlowDirection="LeftToRight"
                               ToolTipService.ToolTip="{x:Bind Title}" />
                    <TextBlock Text="{x:Bind Sub}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxLines="1"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind SubTip}" />
                    <TextBlock Text="{x:Bind Meta}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxLines="1"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FlowDirection="LeftToRight" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="RowTemplate" x:DataType="local:MovieItem">
                <Grid Height="52" ColumnSpacing="12" Padding="4,0" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="46" CornerRadius="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Image Source="{x:Bind RowPoster}" Stretch="UniformToFill" />
                    </Border>
                    <Grid Grid.Column="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                            <TextBlock Text="{x:Bind Sub}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Visibility="{x:Bind FlagVis}" Glyph="&#xE7BA;" FontSize="12" Foreground="#FFD97706" />
                            <FontIcon Visibility="{x:Bind FavVis, Mode=OneWay}" Glyph="&#xEB51;" FontSize="12" Foreground="#FFFF6B81" />
                            <FontIcon Visibility="{x:Bind WatchedVis, Mode=OneWay}" Glyph="&#xE73E;" FontSize="12" Foreground="#FF22C55E" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{x:Bind Year}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{x:Bind RatingText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{x:Bind Votes}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="5" Text="{x:Bind RtText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="{x:Bind McText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="7" Text="{x:Bind MinText}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="8" Text="{x:Bind GenreText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="9" Text="{x:Bind Directors}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="10" Text="{x:Bind QualityText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="FilterTemplate" x:DataType="local:FilterOption">
                <CheckBox Content="{x:Bind Text, Mode=OneWay}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0" Padding="8,0,0,0" />
            </DataTemplate>

            <DataTemplate x:Key="CastTemplate" x:DataType="local:CastItem">
                <Button Click="{x:Bind Open}" ToolTipService.ToolTip="{x:Bind Tip}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="4" Background="Transparent" BorderThickness="0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40" CornerRadius="20" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind Initials}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Image Source="{x:Bind Photo}" Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Role}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>
            </DataTemplate>

            <Style x:Key="ChipBox" TargetType="Border">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="ChipBoxHi" TargetType="Border" BasedOn="{StaticResource ChipBox}">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="ChipText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="ChipTextHi" TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="FileBox" TargetType="Border">
                <Setter Property="Padding" Value="12" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="ToastBox" TargetType="Border">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="MaxWidth" Value="420" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="TopButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Height" Value="34" />
            </Style>
            <Style x:Key="HeadButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
            <Style x:Key="CountBadge" TargetType="Border">
                <Setter Property="MinWidth" Value="18" />
                <Setter Property="Padding" Value="5,0" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="MovieShelf" IsBackButtonVisible="False" IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.Content>
                <Grid x:Name="SearchHost" MaxWidth="600" ColumnSpacing="4" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search titles, people, files…  try  year:1999  rating:>8" QueryIcon="Find" VerticalAlignment="Center"
                                    TextChanged="OnSearchTextChanged" QuerySubmitted="OnSearchSubmitted" GotFocus="OnSearchFocus" LostFocus="OnSearchBlur" />
                    <Border Grid.Column="1" Style="{StaticResource ChipBox}" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="/" FontSize="12" Style="{StaticResource Muted}" />
                    </Border>
                    <Button x:Name="SearchHelpBtn" Grid.Column="2" Style="{StaticResource TopButton}" Click="OnSearchHelp" ToolTipService.ToolTip="Search tips">
                        <SymbolIcon Symbol="Help" />
                    </Button>
                </Grid>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource TopButton}" Click="OnLoadList" ToolTipService.ToolTip="Load a list or folder of movie names into the library">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                            <TextBlock x:Name="LoadListLabel" Text="Load list" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TopButton}" Click="OnCheckList" ToolTipService.ToolTip="Check a list or folder against the library">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9D5;" FontSize="16" />
                            <TextBlock x:Name="CheckLabel" Text="Check list" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ProblemsBtn" Style="{StaticResource TopButton}" Click="OnProblems" ToolTipService.ToolTip="Problems: titles that need a check">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7BA;" FontSize="16" />
                            <TextBlock x:Name="ProblemsLabel" Text="Problems" />
                            <Border x:Name="ProblemsBadge" Style="{StaticResource CountBadge}" Visibility="Collapsed">
                                <TextBlock x:Name="ProblemsCount" FontSize="11" TextAlignment="Center" FlowDirection="LeftToRight" Style="{StaticResource ChipTextHi}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="WishlistBtn" Style="{StaticResource TopButton}" Click="OnWishlist" ToolTipService.ToolTip="Wishlist">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A4;" FontSize="16" />
                            <Border x:Name="WishBadge" Style="{StaticResource CountBadge}" Visibility="Collapsed">
                                <TextBlock x:Name="WishCount" FontSize="11" TextAlignment="Center" FlowDirection="LeftToRight" Style="{StaticResource ChipTextHi}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TopButton}" Click="OnCollections" ToolTipService.ToolTip="Collections: franchises and what is missing">
                        <FontIcon Glyph="&#xE81E;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource TopButton}" Click="OnStats" ToolTipService.ToolTip="Statistics">
                        <FontIcon Glyph="&#xE9D2;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource TopButton}" Click="OnSettings" ToolTipService.ToolTip="Settings and update">
                        <SymbolIcon Symbol="Setting" />
                    </Button>
                    <Button Style="{StaticResource TopButton}" Click="OnHelp" ToolTipService.ToolTip="Help and guides">
                        <SymbolIcon Symbol="Help" />
                    </Button>
                    <Button x:Name="LangBtn" Style="{StaticResource TopButton}" Click="OnLanguageClick" Content="FA" FontWeight="SemiBold" ToolTipService.ToolTip="Language: English / فارسی" />
                    <Button x:Name="ThemeBtn" Style="{StaticResource TopButton}" ToolTipService.ToolTip="Theme">
                        <FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="ThemeMenu" Placement="BottomEdgeAlignedRight" Opening="OnThemeMenuOpening" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid x:Name="JobBar" Grid.Row="1" Visibility="Collapsed" Padding="16,6" ColumnSpacing="12"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="JobProgress" Width="220" VerticalAlignment="Center" />
            <TextBlock x:Name="JobText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Name="JobStop" Grid.Column="2" Content="Stop" Click="OnJobStop" />
            <Button x:Name="JobLog" Grid.Column="3" Content="View log" Click="OnJobLog" Visibility="Collapsed" />
            <Button x:Name="JobDismiss" Grid.Column="4" Click="OnJobDismiss" Visibility="Collapsed" Padding="8,6" ToolTipService.ToolTip="Dismiss this message">
                <FontIcon Glyph="&#xE711;" FontSize="11" />
            </Button>
        </Grid>

        <SplitView x:Name="FilterSplit" Grid.Row="2" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="300"
                   PaneBackground="Transparent">
            <SplitView.Pane>
                <ScrollViewer x:Name="FilterBody" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="12,4,8,12">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="Filters" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            <Button x:Name="ResetBtn" Content="Reset all" HorizontalAlignment="Right" Click="OnResetFilters" />
                        </Grid>
                        <Expander x:Name="SecViews" Tag="views" Header="Saved views" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <StackPanel x:Name="ViewsList" Spacing="2" />
                                <Button x:Name="ViewSaveBtn" Content="Save the current view…" HorizontalAlignment="Stretch" Click="OnViewSave" />
                                <Grid x:Name="ViewSaveRow" Visibility="Collapsed" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ViewName" MaxLength="60" PlaceholderText="Name this view" KeyDown="OnViewNameKey" />
                                    <Button Grid.Column="1" Content="Save" Click="OnViewOk" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="SecLibrary" Tag="library" Header="Library" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <ItemsControl x:Name="StatusList" ItemTemplate="{StaticResource FilterTemplate}" />
                        </Expander>
                        <Expander x:Name="SecGenre" Tag="genre" Header="Genre" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <ItemsControl x:Name="GenreList" ItemTemplate="{StaticResource FilterTemplate}" />
                        </Expander>
                        <Expander x:Name="SecYear" Tag="year" Header="Year" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="YearMin" Header="From" PlaceholderText="1900" Minimum="1880" Maximum="2100"
                                               SpinButtonPlacementMode="Hidden" ValueChanged="OnNumberChanged" />
                                    <NumberBox x:Name="YearMax" Grid.Column="1" Header="To" PlaceholderText="2030" Minimum="1880" Maximum="2100"
                                               SpinButtonPlacementMode="Hidden" ValueChanged="OnNumberChanged" />
                                </Grid>
                                <ItemsControl x:Name="DecadeList" ItemTemplate="{StaticResource FilterTemplate}" />
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="SecScores" Tag="scores" Header="Ratings" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="RatingLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                                <Slider x:Name="RatingMin" Minimum="0" Maximum="9" StepFrequency="0.5" SmallChange="0.5" Value="0"
                                        ValueChanged="OnSliderChanged" />
                                <TextBlock x:Name="VotesLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                                <Slider x:Name="VotesMin" Minimum="0" Maximum="6" StepFrequency="1" SmallChange="1" Value="0"
                                        ValueChanged="OnSliderChanged" />
                                <TextBlock x:Name="RtLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                                <Slider x:Name="RtMin" Minimum="0" Maximum="100" StepFrequency="5" SmallChange="5" Value="0"
                                        ValueChanged="OnSliderChanged" />
                                <TextBlock x:Name="McLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                                <Slider x:Name="McMin" Minimum="0" Maximum="100" StepFrequency="5" SmallChange="5" Value="0"
                                        ValueChanged="OnSliderChanged" />
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="SecRuntime" Tag="runtime" Header="Runtime" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <ItemsControl x:Name="RuntimeList" ItemTemplate="{StaticResource FilterTemplate}" />
                        </Expander>
                        <Expander x:Name="SecQuality" Tag="quality" Header="Quality" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="ResLabel" Text="Resolution" Style="{StaticResource CaptionTextBlockStyle}" />
                                <ItemsControl x:Name="ResList" ItemTemplate="{StaticResource FilterTemplate}" />
                                <TextBlock x:Name="SrcLabel" Text="Source" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,6,0,0" />
                                <ItemsControl x:Name="SrcList" ItemTemplate="{StaticResource FilterTemplate}" />
                                <TextBlock x:Name="TechLabel" Text="Audio and picture" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,6,0,0" />
                                <ItemsControl x:Name="TechList" ItemTemplate="{StaticResource FilterTemplate}" />
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="SecType" Tag="type" Header="Type" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <ItemsControl x:Name="TypeList" ItemTemplate="{StaticResource FilterTemplate}" />
                        </Expander>
                        <Expander x:Name="RegionExpander" Tag="region" Header="Country &amp; language" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <ComboBox x:Name="CountryBox" HorizontalAlignment="Stretch" SelectionChanged="OnRegionChanged" />
                                <ComboBox x:Name="LangBox" HorizontalAlignment="Stretch" SelectionChanged="OnRegionChanged" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </SplitView.Pane>

            <SplitView x:Name="DetailSplit" DisplayMode="Inline" PanePlacement="Right" IsPaneOpen="False" OpenPaneLength="440"
                       PaneBackground="{ThemeResource LayerFillColorDefaultBrush}">
                <SplitView.Pane>
                    <Grid>
                        <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Image x:Name="DetailBackdrop" Height="240" VerticalAlignment="Top" Stretch="UniformToFill" Opacity="0.16" />
                                <StackPanel Padding="20,12,20,24" Spacing="10">
                                    <Button x:Name="CloseDetail" HorizontalAlignment="Right" Click="OnCloseDetail" Padding="8,4" ToolTipService.ToolTip="Close">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="130" Height="195" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Top">
                                            <TextBlock x:Name="DetailPlaceholder" Margin="8" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                                            <Image x:Name="DetailPoster" Stretch="UniformToFill" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock x:Name="DetailTitle" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <Grid x:Name="OrigRow" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Original" FontSize="12" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="OrigText" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </Grid>
                                            <Grid x:Name="PrimRow" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="IMDb" FontSize="12" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="PrimText" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </Grid>
                                            <Grid x:Name="FaRow" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Persian" FontSize="12" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="FaText" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" FlowDirection="RightToLeft" VerticalAlignment="Center" />
                                                <HyperlinkButton x:Name="FaEditBtn" Grid.Column="2" Content="Edit" Padding="0" Click="OnFaEdit" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="FaEditor" Visibility="Collapsed" Spacing="6">
                                        <TextBox x:Name="FaInput" PlaceholderText="عنوان فارسی" FlowDirection="RightToLeft" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="Save" Click="OnFaSave" Style="{StaticResource AccentButtonStyle}" />
                                            <Button Content="Reset" Click="OnFaReset" ToolTipService.ToolTip="Go back to the title from TMDB" />
                                            <HyperlinkButton Content="Cancel" Click="OnFaCancel" />
                                        </StackPanel>
                                    </StackPanel>
                                    <local:WrapPanel x:Name="DetailMeta" HorizontalSpacing="10" VerticalSpacing="6" />
                                    <TextBlock x:Name="TaglineText" FontStyle="Italic" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                                    <TextBlock x:Name="PlotText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock x:Name="DirLabel" Text="Director" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="DirText" TextWrapping="Wrap" IsTextSelectionEnabled="False" FlowDirection="LeftToRight" />
                                    <local:WrapPanel HorizontalSpacing="8" VerticalSpacing="6">
                                        <ToggleButton x:Name="FavToggle" Click="OnFavClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xEB51;" FontSize="14" />
                                                <TextBlock Text="Favorite" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="WatchedToggle" Click="OnWatchedClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE73E;" FontSize="14" />
                                                <TextBlock Text="Watched" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <TextBlock x:Name="WatchedDate" FontSize="12" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <RatingControl x:Name="MyRating" MaxRating="10" ValueChanged="OnMyRatingChanged" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                                            <TextBlock x:Name="MyRatingLabel" FontSize="12" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </local:WrapPanel>
                                    <local:WrapPanel x:Name="LinksPanel" HorizontalSpacing="6" VerticalSpacing="6">
                                        <Button x:Name="ImdbLink" Click="OnOpenImdb" Style="{StaticResource AccentButtonStyle}" />
                                        <Button x:Name="LetterboxdLink" Content="Letterboxd" Click="OnOpenLetterboxd" />
                                        <Button x:Name="TmdbLink" Content="TMDB" Click="OnOpenTmdb" />
                                        <Button x:Name="TrailerLink" Content="Trailer" Click="OnOpenTrailer" />
                                        <Button x:Name="PosterBtn" Click="OnPosterToggle">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                                <TextBlock x:Name="PosterBtnText" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="RemoveAllBtn" Click="OnRemoveMovie" ToolTipService.ToolTip="Take this movie out of your library. Your list files and movie files are not changed.">
                                            <TextBlock x:Name="RemoveAllText" Text="Remove from list" />
                                        </Button>
                                    </local:WrapPanel>
                                    <StackPanel x:Name="PosterBox" Visibility="Collapsed" Spacing="6">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PosterUrl" PlaceholderText="Image address (https://…) or a file path" FlowDirection="LeftToRight" KeyDown="OnPosterKey" />
                                            <Button Grid.Column="1" Content="Use" Click="OnPosterUse" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="Choose an image file…" Click="OnPosterPick" />
                                            <Button x:Name="PosterClearBtn" Content="Remove poster" Click="OnPosterClear" />
                                            <HyperlinkButton Content="Cancel" Click="OnPosterToggle" />
                                        </StackPanel>
                                        <TextBlock x:Name="PosterMsg" FontSize="12" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                    <TextBlock x:Name="CastLabel" Text="Cast" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <ItemsRepeater x:Name="CastList" ItemTemplate="{StaticResource CastTemplate}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="190" MinItemHeight="48" MinRowSpacing="2" MinColumnSpacing="4" ItemsStretch="Fill" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                    <TextBlock x:Name="WriLabel" Text="Writers" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="WriText" TextWrapping="Wrap" FlowDirection="LeftToRight" />
                                    <TextBlock x:Name="CrewLabel" Text="Crew" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="CrewText" TextWrapping="Wrap" FlowDirection="LeftToRight" />
                                    <TextBlock x:Name="AkaLabel" Text="Also known as" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="AkaText" TextWrapping="Wrap" IsTextSelectionEnabled="True" TextAlignment="DetectFromContent" />
                                    <TextBlock Text="Notes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" LostFocus="OnNotesLostFocus" PlaceholderText="Your notes… (saved automatically)" />
                                    <TextBlock Text="Details" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Grid x:Name="DetailFacts" ColumnSpacing="12" RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                    <TextBlock x:Name="FilesLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <StackPanel x:Name="FilesPanel" Spacing="8" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </SplitView.Pane>

                <Grid Padding="8,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12" Margin="4,0,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <SelectorBar x:Name="KindBar" SelectionChanged="OnKindChanged">
                            <SelectorBarItem x:Name="KindAll" Text="All" Tag="all" IsSelected="True" />
                            <SelectorBarItem x:Name="KindMovies" Text="Movies" Tag="movies" />
                            <SelectorBarItem x:Name="KindSeries" Text="Series" Tag="series" />
                        </SelectorBar>
                        <TextBlock x:Name="CountText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="8" Margin="4,0,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="GroupBox" SelectionChanged="OnGroupChanged" MinWidth="150" VerticalAlignment="Center" ToolTipService.ToolTip="Group the results">
                            <ComboBoxItem Content="No grouping" Tag="none" />
                            <ComboBoxItem Content="Group: Decade" Tag="decade" />
                            <ComboBoxItem Content="Group: Year" Tag="year" />
                            <ComboBoxItem Content="Group: Genre" Tag="genre" />
                            <ComboBoxItem Content="Group: IMDb rating" Tag="rating" />
                            <ComboBoxItem Content="Group: Quality" Tag="res" />
                            <ComboBoxItem Content="Group: Type" Tag="type" />
                            <ComboBoxItem Content="Group: Title A–Z" Tag="letter" />
                            <ComboBoxItem Content="Group: Watched" Tag="seen" />
                        </ComboBox>
                        <ComboBox x:Name="SortBox" Grid.Column="1" SelectionChanged="OnSortChanged" MinWidth="160" VerticalAlignment="Center" ToolTipService.ToolTip="Sort the results">
                            <ComboBoxItem Content="Sort: Title" Tag="title" />
                            <ComboBoxItem Content="Sort: Year" Tag="year-desc" />
                            <ComboBoxItem Content="Sort: IMDb rating" Tag="rating" />
                            <ComboBoxItem Content="Sort: Rotten Tomatoes" Tag="rt" />
                            <ComboBoxItem Content="Sort: Metacritic" Tag="mc" />
                            <ComboBoxItem Content="Sort: Popularity" Tag="votes" />
                            <ComboBoxItem Content="Sort: Runtime" Tag="runtime" />
                            <ComboBoxItem Content="Sort: Recently added" Tag="added" />
                            <ComboBoxItem Content="Sort: My rating" Tag="myrating" />
                        </ComboBox>
                        <ToggleButton x:Name="ReverseBtn" Grid.Column="2" Click="OnReverseClick" VerticalAlignment="Center" ToolTipService.ToolTip="Reverse the sort order">
                            <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                        </ToggleButton>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <ToggleButton x:Name="GridBtn" IsChecked="True" Click="OnViewGrid" ToolTipService.ToolTip="Poster grid">
                                <FontIcon Glyph="&#xF0E2;" FontSize="14" />
                            </ToggleButton>
                            <ToggleButton x:Name="ListBtn" Click="OnViewList" ToolTipService.ToolTip="Table">
                                <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                            </ToggleButton>
                        </StackPanel>
                        <CommandBar Grid.Column="4" DefaultLabelPosition="Right" Background="Transparent" HorizontalAlignment="Stretch" IsOpen="False">
                            <AppBarToggleButton x:Name="SelectBtn" Icon="Bullets" Label="Select" Click="OnSelectToggled" ToolTipService.ToolTip="Select several movies to change them together" />
                            <AppBarButton x:Name="ExportBtn" Icon="Share" Label="Export" Click="OnExport" ToolTipService.ToolTip="Export the movies shown to Excel or CSV" />
                            <AppBarButton x:Name="WatchNextBtn" Icon="Shuffle" Label="Watch next" Click="OnWatchNext" ToolTipService.ToolTip="Watch next: picks from the results" />
                            <AppBarButton x:Name="UpdateBtn" Icon="Sync" Label="Update" Click="OnUpdate" ToolTipService.ToolTip="Update the library from your lists" />
                            <CommandBar.SecondaryCommands>
                                <AppBarButton x:Name="PosterSizeBtn" Label="Poster size">
                                    <AppBarButton.Flyout>
                                        <MenuFlyout x:Name="PosterSizeMenu" Opening="OnPosterSizeOpening" />
                                    </AppBarButton.Flyout>
                                </AppBarButton>
                                <AppBarButton Label="Rename plan" Click="OnRenamePlan" />
                                <AppBarButton Label="Backups and restore" Click="OnBackups" />
                            </CommandBar.SecondaryCommands>
                        </CommandBar>
                    </Grid>

                    <local:WrapPanel x:Name="ActiveTags" Grid.Row="2" Visibility="Collapsed" HorizontalSpacing="6" VerticalSpacing="6" Margin="4,0,12,6" />

                    <Grid x:Name="BulkBar" Grid.Row="3" Visibility="Collapsed" Margin="0,0,12,6" Padding="12,6" ColumnSpacing="8"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="BulkCount" VerticalAlignment="Center" Text="Click movies to select them" />
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto">
                            <StackPanel x:Name="BulkActions" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Button Content="Favorite" Tag="fav" Click="OnBulk" />
                                <Button Content="Not favorite" Tag="unfav" Click="OnBulk" />
                                <Button Content="Watched" Tag="seen" Click="OnBulk" />
                                <Button Content="Not watched" Tag="unseen" Click="OnBulk" />
                                <DropDownButton Content="Rate…">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout x:Name="BulkRateMenu" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <Button Content="Wishlist" Tag="wish" Click="OnBulk" />
                                <Button Content="Export" Tag="export" Click="OnBulk" />
                                <Button Content="Remove from list" Tag="remove" Click="OnBulk" />
                                <HyperlinkButton Content="Select all results" Tag="all" Click="OnBulk" />
                                <HyperlinkButton Content="Clear" Tag="none" Click="OnBulk" />
                                <Button Content="Done" Tag="done" Click="OnBulk" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Row="4">
                        <GridView x:Name="MovieGrid" ItemTemplate="{StaticResource CardTemplate}" SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="OnItemClick" SelectionChanged="OnSelectionChanged" FlowDirection="LeftToRight"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="4,0,4,16">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" CacheLength="1" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.GroupStyle>
                                <GroupStyle HidesIfEmpty="False">
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Button Click="OnGroupHeader" Tag="{Binding Label}" Background="Transparent" BorderThickness="0" Padding="2,2" Margin="4,10,0,2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="{Binding Chevron}" FontSize="11" />
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                                    <TextBlock Text="{Binding TotalText}" VerticalAlignment="Bottom" Opacity="0.6" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </GridView.GroupStyle>
                        </GridView>
                        <ScrollViewer x:Name="ListHost" Visibility="Collapsed" SizeChanged="OnListSized" FlowDirection="LeftToRight" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                        <Grid x:Name="ListGrid" MinWidth="1120">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="12" Padding="12,4,16,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="HeadTitle" Grid.Column="1" Tag="title" Style="{StaticResource HeadButton}" Click="OnHeaderSort" />
                                <Button x:Name="HeadYear" Grid.Column="2" Tag="year-desc" Style="{StaticResource HeadButton}" Click="OnHeaderSort" />
                                <Button x:Name="HeadImdb" Grid.Column="3" Tag="rating" Style="{StaticResource HeadButton}" Click="OnHeaderSort" />
                                <Button x:Name="HeadVotes" Grid.Column="4" Tag="votes" Style="{StaticResource HeadButton}" Click="OnHeaderSort" />
                                <Button x:Name="HeadRt" Grid.Column="5" Tag="rt" Style="{StaticResource HeadButton}" Click="OnHeaderSort" ToolTipService.ToolTip="Rotten Tomatoes" />
                                <Button x:Name="HeadMc" Grid.Column="6" Tag="mc" Style="{StaticResource HeadButton}" Click="OnHeaderSort" ToolTipService.ToolTip="Metacritic" />
                                <Button x:Name="HeadMin" Grid.Column="7" Tag="runtime" Style="{StaticResource HeadButton}" Click="OnHeaderSort" />
                                <TextBlock x:Name="HeadGenres" Grid.Column="8" Text="Genres" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="HeadDirector" Grid.Column="9" Text="Director" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="HeadQuality" Grid.Column="10" Text="Quality" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <ListView x:Name="MovieList" Grid.Row="1" ItemTemplate="{StaticResource RowTemplate}" SelectionMode="None" IsItemClickEnabled="True"
                                      ItemClick="OnItemClick" SelectionChanged="OnSelectionChanged">
                                <ListView.GroupStyle>
                                    <GroupStyle HidesIfEmpty="False">
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Button Click="OnGroupHeader" Tag="{Binding Label}" Background="Transparent" BorderThickness="0" Padding="2,2" Margin="2,8,0,2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="{Binding Chevron}" FontSize="11" />
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                                        <TextBlock Text="{Binding TotalText}" VerticalAlignment="Bottom" Opacity="0.6" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListView.GroupStyle>
                            </ListView>
                        </Grid>
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="520">
                            <TextBlock x:Name="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="EmptyText" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                            <StackPanel x:Name="EmptyButtons" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <ProgressRing x:Name="LoadRing" IsActive="False" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </SplitView>
        </SplitView>

        <Button x:Name="ToTopBtn" Grid.Row="2" Visibility="Collapsed" Width="40" Height="40" Padding="0" CornerRadius="20" Margin="24"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="OnToTop" ToolTipService.ToolTip="Back to top">
            <FontIcon Glyph="&#xE70E;" FontSize="14" />
        </Button>

        <StackPanel x:Name="ToastHost" Grid.Row="1" Grid.RowSpan="2" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" />

        <Border x:Name="QPanel" Visibility="Collapsed" Grid.Row="1" Grid.RowSpan="2" Width="600" MaxHeight="560" HorizontalAlignment="Left" VerticalAlignment="Top"
                Padding="14" CornerRadius="8" BorderThickness="1" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="QPanelBody" Spacing="6" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
