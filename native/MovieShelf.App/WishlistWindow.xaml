<Window
    x:Class="MovieShelf.App.WishlistWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MovieShelf.App">

    <Grid x:Name="Root">
        <Grid.Resources>
            <DataTemplate x:Key="WishTemplate" x:DataType="local:WishVm">
                <StackPanel Padding="16,10" Spacing="4" Opacity="{x:Bind Dim}">
                    <local:WrapPanel HorizontalSpacing="10" VerticalSpacing="4">
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" FlowDirection="{x:Bind TitleFlow}" />
                        <Border CornerRadius="4" Padding="8,1,8,2" VerticalAlignment="Center" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="{x:Bind WantedVis}">
                            <TextBlock Text="{x:Bind WantedLabel}" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </Border>
                        <Border CornerRadius="4" Padding="8,1,8,2" VerticalAlignment="Center" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" Visibility="{x:Bind FoundVis}">
                            <TextBlock Text="{x:Bind FoundLabel}" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </Border>
                    </local:WrapPanel>
                    <TextBlock Text="{x:Bind Sub}" Visibility="{x:Bind SubVis}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="{x:Bind ToggleLabel}" Tag="{x:Bind}" Click="OnToggle" />
                        <Button Content="{x:Bind ImdbLabel}" Tag="{x:Bind}" Click="OnImdb" Visibility="{x:Bind ImdbVis}" />
                        <Button Content="{x:Bind RemoveLabel}" Tag="{x:Bind}" Click="OnRemove" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Wishlist" IsBackButtonVisible="False" />

        <InfoBar x:Name="Info" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="16,0,16,8" />

        <StackPanel Grid.Row="2" Padding="16,4,16,8" Spacing="8">
            <TextBlock Text="Movies you want to get or replace with a better copy. Add them from the list check, from Problems, from Collections, or here."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewTitle" PlaceholderText="Title (Year), for example Heat (1995)" KeyDown="OnNewKey" />
                <Button x:Name="AddBtn" Grid.Column="1" Content="Add" Style="{StaticResource AccentButtonStyle}" Click="OnAdd" />
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="3" Padding="16,0,16,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
            <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged" />
        </ScrollViewer>

        <Grid Grid.Row="4">
            <ListView x:Name="List" ItemTemplate="{StaticResource WishTemplate}" SelectionMode="None" />
            <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Visibility="Collapsed">
                <FontIcon Glyph="&#xE734;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyText" Text="The wishlist is empty." HorizontalAlignment="Center" />
            </StackPanel>
            <ProgressRing x:Name="Ring" IsActive="True" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="5" Padding="16,8,16,12" ColumnSpacing="8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Summary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="CopyBtn" Click="OnCopy">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                        <TextBlock Text="Copy wanted" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveTxtBtn" Content="Save as text" Click="OnSaveText" />
                <Button x:Name="SaveCsvBtn" Content="Save as CSV" Click="OnSaveCsv" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
