<Window
    x:Class="MovieShelf.App.CollectionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MovieShelf.App">

    <Grid x:Name="Root">
        <Grid.Resources>
            <DataTemplate x:Key="CollTemplate" x:DataType="local:CollVm">
                <StackPanel Padding="16,12" Spacing="6" Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" FlowDirection="LeftToRight" />
                        <TextBlock Text="{x:Bind Sub}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Grid ColumnSpacing="10" Visibility="{x:Bind MissingBlockVis}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="4" Padding="8,1,8,2" VerticalAlignment="Top" Margin="0,2,0,0" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                            <TextBlock Text="{x:Bind MissingTag}" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </Border>
                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Missing}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:WrapPanel HorizontalSpacing="18" VerticalSpacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:MissingVm">
                                    <TextBlock Text="{x:Bind Text}" FlowDirection="LeftToRight" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <Grid ColumnSpacing="10" Visibility="{x:Bind HaveBlockVis}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="4" Padding="8,1,8,2" VerticalAlignment="Top" Margin="0,5,0,0" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                            <TextBlock Text="{x:Bind HaveTag}" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </Border>
                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Have}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:WrapPanel HorizontalSpacing="18" VerticalSpacing="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:HaveVm">
                                    <StackPanel>
                                        <HyperlinkButton Content="{x:Bind Text}" Tag="{x:Bind}" Click="OnOpenMovie" Padding="0,4" Visibility="{x:Bind LinkVis}" FlowDirection="LeftToRight" />
                                        <TextBlock Text="{x:Bind Text}" Margin="0,4" Visibility="{x:Bind PlainVis}" FlowDirection="LeftToRight" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <local:WrapPanel HorizontalSpacing="8" VerticalSpacing="4" Margin="0,4,0,0">
                        <Button Content="{x:Bind AddLabel}" Tag="{x:Bind}" Click="OnAddMissing" Visibility="{x:Bind AddVis}" />
                        <Button Content="{x:Bind ShowLabel}" Tag="{x:Bind}" Click="OnShowInLibrary" Visibility="{x:Bind ShowVis}" />
                    </local:WrapPanel>
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Collections" IsBackButtonVisible="False" />

        <InfoBar x:Name="Info" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="16,0,16,8" />
        <InfoBar x:Name="NoKey" Grid.Row="2" IsOpen="False" IsClosable="False" Severity="Warning" Margin="16,0,16,8"
                 Title="Collections need a TMDB key"
                 Message="Add a free TMDB key in Settings, Online data. Then press Fetch collection details." />

        <StackPanel Grid.Row="3" Padding="16,4,16,8" Spacing="10">
            <TextBlock Text="Franchises in your library, and the movies of each that you do not have yet. The list of parts comes from TMDB."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="FetchBtn" Click="OnFetch" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                        <TextBlock Text="Fetch collection details" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="FetchNote" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Grid x:Name="JobPanel" Visibility="Collapsed" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="JobText" />
                    <ProgressBar x:Name="JobBar" IsIndeterminate="True" />
                </StackPanel>
                <Button x:Name="StopBtn" Grid.Column="1" Content="Stop" Click="OnStop" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="4" Padding="16,0,16,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
            <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged" />
        </ScrollViewer>

        <Grid Grid.Row="5">
            <ListView x:Name="List" ItemTemplate="{StaticResource CollTemplate}" SelectionMode="None" />
            <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Visibility="Collapsed">
                <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyText" Text="No collections known yet." HorizontalAlignment="Center" />
            </StackPanel>
            <ProgressRing x:Name="Ring" IsActive="True" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
