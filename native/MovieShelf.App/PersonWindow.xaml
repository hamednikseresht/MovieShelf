<Window
    x:Class="MovieShelf.App.PersonWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MovieShelf.App">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Person" IsBackButtonVisible="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
            <StackPanel Padding="24,4,24,28" Spacing="14" MaxWidth="980" HorizontalAlignment="Stretch">
                <!-- who -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="150" Height="225" CornerRadius="8" VerticalAlignment="Top" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid>
                            <Image x:Name="Photo" Stretch="UniformToFill" />
                            <TextBlock x:Name="Initials" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="44" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FlowDirection="LeftToRight" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                        <TextBlock x:Name="NameText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <local:WrapPanel x:Name="Chips" HorizontalSpacing="6" VerticalSpacing="6" />
                        <StackPanel x:Name="Facts" Spacing="3" />
                        <local:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" Margin="0,4,0,0">
                            <Button x:Name="FilterBtn" Click="OnShowInLibrary" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                            <Button x:Name="ImdbBtn" Click="OnOpenImdb">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                                    <TextBlock Text="Open on IMDb" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TmdbBtn" Content="TMDB" Click="OnOpenTmdb" Visibility="Collapsed" />
                            <Button x:Name="SiteBtn" Content="Website" Click="OnOpenSite" Visibility="Collapsed" />
                            <Button x:Name="RefreshBtn" Click="OnRefresh" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Refresh" />
                                </StackPanel>
                            </Button>
                        </local:WrapPanel>
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="NoKey" Severity="Warning" IsOpen="False" IsClosable="False"
                         Title="Add a TMDB key in Settings for photo and biography"
                         Message="The photo, the biography and the full filmography come from TMDB. A free key is enough." />
                <InfoBar x:Name="Err" Severity="Error" IsOpen="False" IsClosable="True" />
                <StackPanel x:Name="Busy" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <ProgressRing IsActive="True" Width="28" Height="28" />
                    <TextBlock Text="Loading the profile…" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- biography -->
                <StackPanel x:Name="BioBox" Spacing="2" Visibility="Collapsed">
                    <TextBlock x:Name="BioText" TextWrapping="Wrap" IsTextSelectionEnabled="True" MaxLines="6" TextTrimming="CharacterEllipsis" />
                    <HyperlinkButton x:Name="BioMore" Content="Read more" Click="OnBioMore" Padding="0" Visibility="Collapsed" />
                </StackPanel>

                <!-- jobs -->
                <ScrollViewer x:Name="TabsBox" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged" />
                </ScrollViewer>

                <!-- in the library -->
                <StackPanel x:Name="LibBox" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="LibHead" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <local:WrapPanel x:Name="Cards" HorizontalSpacing="12" VerticalSpacing="14" />
                    <Button x:Name="CardsMore" Click="OnMoreCards" Visibility="Collapsed" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- filmography -->
                <StackPanel x:Name="FilmBox" Spacing="8" Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FilmHead" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <ComboBox x:Name="SortBox" Grid.Column="1" SelectionChanged="OnSortChanged" MinWidth="160">
                            <ComboBoxItem Content="Newest first" Tag="new" />
                            <ComboBoxItem Content="Oldest first" Tag="old" />
                            <ComboBoxItem Content="Most votes" Tag="votes" />
                        </ComboBox>
                    </Grid>
                    <StackPanel x:Name="Credits" Spacing="0" />
                    <Button x:Name="MoreBtn" Click="OnMoreCredits" Visibility="Collapsed" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
