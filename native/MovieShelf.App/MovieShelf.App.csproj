<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MovieShelf.App</RootNamespace>
    <AssemblyName>MovieShelf</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\tools\icon\MovieShelf.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>MovieShelf</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <ProjectReference Include="..\MovieShelf.Core\MovieShelf.Core.csproj" />
    <Content Include="..\..\tools\icon\MovieShelf.ico" Link="Assets\MovieShelf.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Help\en.html" LogicalName="help.en.html" />
    <EmbeddedResource Include="Help\fa.html" LogicalName="help.fa.html" />
  </ItemGroup>
</Project>
